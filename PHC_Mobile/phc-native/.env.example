# PHC mobile app — required build-time env (Expo public vars are embedded in
# the APK, so ONLY put public values here). Copy to `.env` and fill in.
#
# Both values are safe to ship in the client:
#  - the Supabase URL is public
#  - the ANON key is the public anonymous key (RLS enforces access; it is NOT
#    the service_role key and must never be replaced with one here)
#
# Find them in: Supabase dashboard -> Project Settings -> API.

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# NEVER put these in this file or any client env:
#  - SUPABASE_SERVICE_ROLE_KEY  (server/Edge Functions only)
#  - Supabase Management PAT
#  - Android signing key / passwords (see secrets/, git-ignored)
