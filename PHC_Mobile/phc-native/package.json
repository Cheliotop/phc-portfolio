{
  "name": "phc-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "test": "NODE_ENV=test jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "gen:types": "cd ../.. && supabase gen types typescript --local > PHC_Mobile/phc-native/src/types/supabase.generated.ts",
    "create:android:signing-key": "node scripts/create-android-signing-key.js",
    "validate:android:release": "node scripts/validate-android-release.js",
    "validate:android:local-qa": "node scripts/validate-android-local-qa.js",
    "bundle:android": "npx expo export:embed --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "build:android:debug": "node scripts/check-java.js && cd android && ./gradlew assembleDebug",
    "build:android:local-qa": "node scripts/check-java.js && node scripts/validate-android-local-qa.js && cd android && ./gradlew clean assembleLocalQa && cd .. && node scripts/copy-android-artifact.js localQa apk",
    "build:android:release": "node scripts/check-java.js && node scripts/validate-android-release.js && cd android && ./gradlew clean assembleRelease && cd .. && node scripts/copy-android-artifact.js release apk",
    "build:android:bundle": "node scripts/check-java.js && node scripts/validate-android-release.js && cd android && ./gradlew clean bundleRelease && cd .. && node scripts/copy-android-artifact.js release aab",
    "prebuild": "npx expo prebuild --platform android --clean"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/material-top-tabs": "^7.6.13",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/stack": "^7.10.17",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-query": "^5.59.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native/babel-preset": "^0.81.5",
    "@react-native/eslint-config": "^0.81.5",
    "@react-native/metro-config": "^0.81.5",
    "@react-native/typescript-config": "^0.81.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "@xmldom/xmldom": "0.9.12",
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "postcss": "8.5.28",
    "browserslist": "4.28.9",
    "baseline-browser-mapping": "2.11.21",
    "decode-uri-component": "0.5.1",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "compression": "1.8.2",
    "node-forge": "1.4.2",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "undici@6": "6.29.1",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
